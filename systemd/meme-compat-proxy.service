[Unit]
Description=Meme API compatibility proxy for meme-plugin
After=network-online.target meme-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
Environment=MEME_BACKEND=http://127.0.0.1:2233
Environment=MEME_FALLBACK=https://meme.pippi.top/pippi
Environment=MEME_ENABLE_FALLBACK=1
ExecStart=/usr/bin/python3 __INSTALL_DIR__/proxy/meme_compat_proxy.py --host __PROXY_HOST__ --port __PROXY_PORT__
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
