FROM python:3.12-slim
RUN pip install --no-cache-dir requests
COPY proxy/meme_compat_proxy.py /app/meme_compat_proxy.py
WORKDIR /app
ENV MEME_BACKEND=http://meme-api:2233
ENV MEME_FALLBACK=https://meme.pippi.top/pippi
ENV MEME_ENABLE_FALLBACK=1
EXPOSE 2234
CMD ["python", "/app/meme_compat_proxy.py", "--host", "0.0.0.0", "--port", "2234"]
